{
  "name": "project-aqua",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "phone:test": "node scripts/phone-test.mjs",
    "fieldkit:build": "npm run build -w @aqua/web",
    "build": "tsc -b && npm run build -w @aqua/web",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run --configLoader runner --config vitest.config.mjs tests/unit tests/integration",
    "test:unit": "vitest run --configLoader runner --config vitest.config.mjs tests/unit",
    "test:integration": "vitest run --configLoader runner --config vitest.config.mjs tests/integration",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@noble/curves": "^1.8.2",
    "@noble/hashes": "^1.7.2",
    "@vitejs/plugin-react": "^4.3.4",
    "dexie": "^4.0.11",
    "vite": "^6.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "ws": "^8.18.0"
  }
}
